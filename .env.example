# 텔레그램 봇 토큰 (@BotFather 에서 /newbot 으로 발급)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 알림을 받을 채팅 ID
#  - 개인: @userinfobot 에게 아무 메시지나 보내면 알려줌
#  - 그룹: 봇을 그룹에 초대한 뒤 아무 메시지나 쓰고
#          https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인 (보통 음수)
TELEGRAM_CHAT_ID=987654321

# 감시할 게시판 (기본값: 인하대 의과대학 공지사항)
BOARD_URL=https://medicine.inha.ac.kr/medicine/13793/subview.do

# 알림 메시지 머리말에 붙는 게시판 이름
BOARD_NAME=인하대 의과대학 공지

# 이미 알린 글을 기록하는 파일
STATE_FILE=state.json

# watch 모드 확인 주기(초). 최소 60, 기본 600(10분)
CHECK_INTERVAL=600

# 한 번에 보낼 최대 알림 수 (0이면 무제한)
MAX_PER_RUN=10

# 첫 실행에도 현재 목록을 전부 알릴지 (기본 false = 알림 없이 기록만)
NOTIFY_FIRST_RUN=false
